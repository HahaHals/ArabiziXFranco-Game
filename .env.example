# Local dev uses SQLite; production uses Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/franco
DATABASE_URL=sqlite:///./franco.db

# Used to sign owner session cookies (step 2). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Set to true in production (HTTPS), so the login cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# Lets you create the first owner account in the browser at /owner/setup.
# At least 12 characters. The page switches itself off once an owner exists.
SETUP_CODE=

# Server-side only; never sent to the browser (step 6).
ANTHROPIC_API_KEY=
# Cheapest; use claude-sonnet-5-5 if the sentences come out unnatural.
ANTHROPIC_MODEL=claude-haiku-5-5
